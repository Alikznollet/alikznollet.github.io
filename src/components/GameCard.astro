---
import { Image } from 'astro:assets';
import Badge from './Badge.astro';

interface Props {
	title: string;
	description: string;
	url: string;
	coverImage?: any;
	genres?: string[];
	gameJam?: {
		placement: string;
		url: string;
		name?: string;
	};
}

const { title, description, url, coverImage, genres = [], gameJam } = Astro.props;
---

<div class="game-card">
	{gameJam && (
		<a href={gameJam.url} class="jam-ribbon" target="_blank" rel="noopener noreferrer">
			<span class="placement">{gameJam.placement} - {gameJam.name}</span>
		</a>
	)}
	
	<a href={url} class="card-link" aria-label={`View details for ${title}`}>
		<div class="visual-container">
			{coverImage ? (
				<Image src={coverImage} alt={title} class="game-image" />
			) : (
				<div class="game-placeholder">
					<span>Gameplay Preview</span>
				</div>
			)}
		</div>
		<div class="content">
			<div class="header">
				<h3>{title}</h3>
				<div class="badges">
					{genres.map(genre => <Badge text={genre} />)}
				</div>
			</div>
			<p>{description}</p>
		</div>
	</a>
</div>

<style>
	.game-card {
		position: relative;
		border-radius: 8px;
		background-color: var(--card-bg);
		border: 1px solid var(--card-border);
		margin-bottom: 1.5rem;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.game-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}

	.jam-ribbon {
		position: absolute;
		top: 0.5rem;
		left: 0.5rem;
		z-index: 20;
		background: var(--accent);
		color: #000;
		padding: 4px 10px;
		border-radius: 4px;
		font-size: 0.75rem;
		font-weight: 800;
		text-decoration: none;
		box-shadow: 0 4px 10px rgba(0,0,0,0.4);
		transition: transform 0.2s ease, background 0.2s ease;
	}

	.jam-ribbon:hover {
		transform: scale(1.1);
		background: #ffffff;
	}

	.card-link {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: 1.5rem;
		padding: 1rem;
		text-decoration: none;
		color: inherit;
	}

	.visual-container {
		width: 200px;
		height: 120px;
		border-radius: 4px;
		overflow: hidden;
		background-color: #000;
		border: 1px solid var(--card-border);
	}

	.game-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.game-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-dim);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.content {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.header {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
	}

	.badges {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	h3 {
		margin: 0;
		color: #ffffff;
		line-height: 1.2;
	}

	p {
		margin: 0;
		color: var(--text-dim);
		font-size: 0.95rem;
	}

	@media (max-width: 600px) {
		.card-link {
			grid-template-columns: 1fr;
		}
		.visual-container {
			width: 100%;
			height: 180px;
		}
		.jam-ribbon {
			top: 0.5rem;
			left: 0.5rem;
		}
	}
</style>
