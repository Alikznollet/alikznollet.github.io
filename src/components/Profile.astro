---
import { Image } from 'astro:assets';

interface Props {
	name: string;
	description: string;
	imageUrl?: any;
}

const { name, description, imageUrl } = Astro.props;
---

<div class="profile">
	<div class="avatar-container">
		{imageUrl ? (
			typeof imageUrl === 'string' ? (
				<img src={imageUrl} alt={name} class="avatar" />
			) : (
				<Image src={imageUrl} alt={name} class="avatar" />
			)
		) : (
			<div class="avatar-placeholder"></div>
		)}
	</div>
	<div class="info">
		<h1>{name}</h1>
		<p class="description">{description}</p>
	</div>
</div>

<style>
	.profile {
		display: flex;
		align-items: center;
		gap: 2.5rem;
		margin-bottom: 5rem;
	}

	.avatar-container {
		flex-shrink: 0;
		display: flex; /* Ensures image respects container alignment */
		align-items: center;
	}

	.avatar, .avatar-placeholder {
		width: 150px;
		height: 150px;
		border-radius: 50%;
		object-fit: cover;
		background-color: var(--card-bg);
		border: 2px solid var(--card-border);
		display: block; /* Removes any inline spacing */
	}

	.avatar-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
	}

	.avatar-placeholder::after {
		content: '👤';
		font-size: 4rem;
	}

	.info {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.info h1 {
		margin: 0 0 0.25rem 0;
		font-size: 3rem;
		line-height: 1.1;
	}

	.description {
		font-size: 1.2rem;
		color: var(--text-dim);
		max-width: 550px;
		margin: 0;
		line-height: 1.5;
	}

	@media (max-width: 600px) {
		.profile {
			flex-direction: column;
			text-align: center;
			gap: 1.5rem;
			margin-bottom: 3rem;
		}

		.info h1 {
			font-size: 2.5rem;
		}
	}
</style>
