---
interface Props {
	url: string;
	platform: 'itch' | 'steam';
}

const { url, platform } = Astro.props;

const config = {
	itch: {
		label: 'Play on itch.io',
		icon: `<svg viewBox="0 0 24 24" fill="currentColor" class="store-icon"><path d="M3.13 1.338C2.08 1.96.02 4.328 0 4.95v1.03c0 1.303 1.22 2.45 2.325 2.45 1.33 0 2.436-1.102 2.436-2.41 0 1.308 1.07 2.41 2.4 2.41 1.328 0 2.362-1.102 2.362-2.41 0 1.308 1.137 2.41 2.466 2.41h.024c1.33 0 2.466-1.102 2.466-2.41 0 1.308 1.034 2.41 2.363 2.41 1.33 0 2.4-1.102 2.4-2.41 0 1.308 1.106 2.41 2.435 2.41C22.78 8.43 24 7.282 24 5.98V4.95c-.02-.62-2.082-2.99-3.13-3.612-3.253-.114-5.508-.134-8.87-.133-3.362 0-7.945.053-8.87.133zm6.376 6.477a2.74 2.74 0 0 1-.468.602c-.5.49-1.19.795-1.947.795a2.786 2.786 0 0 1-1.95-.795c-.182-.178-.32-.37-.446-.59-.127.222-.303.412-.486.59a2.788 2.788 0 0 1-1.95.795c-.092 0-.187-.025-.264-.052-.107 1.113-.152 2.176-.168 2.95v.005l-.006 1.167c.02 2.334-.23 7.564 1.03 8.85 1.952.454 5.545.662 9.15.663 3.605 0 7.198-.21 9.15-.664 1.26-1.284 1.01-6.514 1.03-8.848l-.006-1.167v-.004c-.016-.775-.06-1.838-.168-2.95-.077.026-.172.052-.263.052a2.788 2.788 0 0 1-1.95-.795c-.184-.178-.36-.368-.486-.59-.127.22-.265.412-.447.59a2.786 2.786 0 0 1-1.95.794c-.76 0-1.446-.303-1.948-.793a2.74 2.74 0 0 1-.468-.602 2.738 2.738 0 0 1-.463.602 2.787 2.787 0 0 1-1.95.794h-.16a2.787 2.787 0 0 1-1.95-.793 2.738 2.738 0 0 1-.464-.602zm-2.004 2.59v.002c.795.002 1.5 0 2.373.953.687-.072 1.406-.108 2.125-.107.72 0 1.438.035 2.125.107.873-.953 1.578-.95 2.372-.953.376 0 1.876 0 2.92 2.934l1.123 4.028c.832 2.995-.266 3.068-1.636 3.07-2.03-.075-3.156-1.55-3.156-3.025-1.124.184-2.436.276-3.748.277-1.312 0-2.624-.093-3.748-.277 0 1.475-1.125 2.95-3.156 3.026-1.37-.004-2.468-.077-1.636-3.072l1.122-4.027c1.045-2.934 2.545-2.934 2.92-2.934zM12 12.714c-.002.002-2.14 1.964-2.523 2.662l1.4-.056v1.22c0 .056.56.033 1.123.007.562.026 1.124.05 1.124-.008v-1.22l1.4.055C14.138 14.677 12 12.713 12 12.713z"/></svg>`,
		color: '#fa5c5c',
	},
	steam: {
		label: 'Buy on Steam',
		icon: `<svg viewBox="0 0 24 24" fill="currentColor" class="store-icon"><path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.153-3.328-2.678l-4.36-1.796A12.017 12.017 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 11.979 0zM7.544 14.762a1.66 1.66 0 0 1 1.656 1.663 1.66 1.66 0 0 1-1.656 1.663 1.66 1.66 0 0 1-1.656-1.663 1.66 1.66 0 0 1 1.656-1.663zm8.435-8.37a2.501 2.501 0 0 1 2.5 2.513 2.501 2.501 0 0 1-2.5 2.513 2.501 2.501 0 0 1-2.5-2.513 2.501 2.501 0 0 1 2.5-2.513zm0 .837a1.663 1.663 0 0 0-1.667 1.676 1.663 1.663 0 0 0 1.667 1.676 1.663 1.663 0 0 0 1.667-1.676 1.663 1.663 0 0 0-1.667-1.676z"/></svg>`,
		color: '#1b2838', // This is still the brand color but we'll use white for the icon itself
	}
};

const current = config[platform];
---

<a href={url} target="_blank" rel="noopener noreferrer" class="store-card" style={`--brand-color: ${current.color};`}>
	<div class="icon-side">
		<Fragment set:html={current.icon} />
	</div>
	<div class="info-side">
		<span class="label">{current.label}</span>
		<span class="platform-name">{platform === 'itch' ? 'itch.io' : 'Steam'}</span>
	</div>
	<div class="arrow-side">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
	</div>
</a>

<style>
	.store-card {
		display: flex;
		align-items: center;
		padding: 1.25rem 1.5rem;
		background-color: #1a1a1a;
		border: 1px solid var(--card-border);
		border-radius: 12px;
		text-decoration: none;
		color: var(--text-color);
		transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
		width: 100%;
		max-width: 350px; /* Reduced slightly to ensure two can fit side-by-side on typical screens */
		flex: 1 1 300px;
	}

	.store-card:hover {
		border-color: var(--brand-color);
		background-color: #222;
		transform: translateY(-2px);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
		text-decoration: none;
	}

	.icon-side {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		background-color: #252525;
		border-radius: 10px;
		margin-right: 1.25rem;
		color: #ffffff; /* Icon is now always white for visibility */
	}

	.store-icon {
		width: 22px;
		height: 22px;
	}

	.store-card:hover .icon-side {
		color: var(--brand-color); /* Icon takes brand color on hover */
	}

	.info-side {
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.label {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-dim);
		font-weight: 600;
		margin-bottom: 0.15rem;
	}

	.platform-name {
		font-size: 1.1rem;
		font-weight: 700;
		color: #ffffff;
	}

	.arrow-side {
		color: var(--text-dim);
		transition: transform 0.2s ease, color 0.2s ease;
	}

	.store-card:hover .arrow-side {
		transform: translate(2px, -2px);
		color: var(--brand-color);
	}

	.arrow-icon {
		width: 20px;
		height: 20px;
	}

	@media (max-width: 600px) {
		.store-card {
			max-width: 100%;
			flex: 1 1 100%;
		}
	}
</style>
