---
import Badge from './Badge.astro';

interface Props {
	title: string;
	description: string;
	url?: string;
	tags?: string[];
}

const { title, description, url, tags = [] } = Astro.props;
---

<div class="project-card">
	<a href={url} class="card-link" aria-label={`View details for ${title}`}>
		<div class="content">
			<div class="header">
				<h3>{title}</h3>
				{tags.length > 0 && (
					<div class="tags">
						{tags.map(tag => <Badge text={tag} />)}
					</div>
				)}
			</div>
			<p>{description}</p>
		</div>
	</a>
</div>

<style>
	.project-card {
		border-radius: 8px;
		background-color: var(--card-bg);
		border: 1px solid var(--card-border);
		transition: transform 0.2s ease, border-color 0.2s ease;
		margin-bottom: 1rem;
	}

	.project-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}

	.card-link {
		display: block;
		padding: 1.5rem;
		text-decoration: none;
		color: inherit;
	}

	.header {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
		flex-wrap: wrap;
	}

	h3 {
		margin: 0;
		color: #ffffff;
		line-height: 1.2;
	}

	p {
		color: var(--text-dim);
		margin: 0;
		font-size: 0.95rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
</style>
