---
import Badge from './Badge.astro';

interface Props {
	title: string;
	description: string;
	url?: string;
	tags?: string[];
	githubUrl?: string;
}

const { title, description, url, tags = [], githubUrl } = Astro.props;

// Fetch stars from GitHub API if githubUrl is provided
let stars = 0;
if (githubUrl) {
	try {
		const cleanUrl = githubUrl.replace(/\/$/, '');
		const parts = cleanUrl.split('/');
		const owner = parts[parts.length - 2];
		const repo = parts[parts.length - 1];
		
		const response = await fetch(`https://api.github.com/repos/${owner}/${repo}`);
		if (response.ok) {
			const data = await response.json();
			stars = data.stargazers_count;
		}
	} catch (e) {
		console.error(`Failed to fetch stars for ${githubUrl}`, e);
	}
}
---

<div class="project-card">
	<a href={url} class="card-link" aria-label={`View details for ${title}`}>
		<div class="content">
			<div class="header">
				<div class="title-area">
					<h3>{title}</h3>
					{tags.length > 0 && (
						<div class="tags">
							{tags.map(tag => <Badge text={tag} />)}
						</div>
					)}
				</div>
				{stars > 0 && (
					<div class="stars" title={`${stars} stars on GitHub`}>
						<svg viewBox="0 0 24 24" fill="currentColor" stroke="none" class="star-icon"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
						<span>{stars}</span>
					</div>
				)}
			</div>
			<p>{description}</p>
		</div>
	</a>
</div>

<style>
	.project-card {
		border-radius: 8px;
		background-color: var(--card-bg);
		border: 1px solid var(--card-border);
		transition: transform 0.2s ease, border-color 0.2s ease;
		margin-bottom: 1rem;
	}

	.project-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}

	.card-link {
		display: block;
		padding: 1.5rem;
		text-decoration: none;
		color: inherit;
	}

	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
		flex-wrap: wrap;
	}

	.title-area {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	h3 {
		margin: 0;
		color: #ffffff;
		line-height: 1.2;
	}

	p {
		color: var(--text-dim);
		margin: 0;
		font-size: 0.95rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.stars {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.85rem;
		color: #e3b341;
		font-weight: 600;
		background: rgba(227, 179, 65, 0.1);
		padding: 0.1rem 0.5rem;
		border-radius: 12px;
	}

	.star-icon {
		width: 12px;
		height: 12px;
	}

	@media (max-width: 600px) {
		.header {
			flex-direction: row;
			justify-content: space-between;
		}
		
		.title-area {
			flex: 1;
		}
	}
</style>

