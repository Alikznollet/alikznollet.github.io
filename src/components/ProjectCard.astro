---
interface Props {
	title: string;
	description: string;
	url?: string;
	tags?: string[];
}

const { title, description, url, tags = [] } = Astro.props;
---

<div class="project-card">
	<div class="content">
		<h3>
			{url ? <a href={url} target="_blank" rel="noopener noreferrer">{title}</a> : title}
		</h3>
		<p>{description}</p>
		{tags.length > 0 && (
			<div class="tags">
				{tags.map(tag => <span class="tag">{tag}</span>)}
			</div>
		)}
	</div>
</div>

<style>
	.project-card {
		padding: 1.5rem;
		border-radius: 8px;
		background-color: var(--card-bg);
		border: 1px solid var(--card-border);
		transition: transform 0.2s ease, border-color 0.2s ease;
		margin-bottom: 1rem;
	}

	.project-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}

	h3 {
		margin-top: 0;
		margin-bottom: 0.5rem;
	}

	p {
		color: var(--text-dim);
		margin-bottom: 1rem;
		font-size: 0.95rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag {
		font-size: 0.75rem;
		background-color: rgba(187, 134, 252, 0.1);
		color: var(--accent);
		padding: 0.2rem 0.5rem;
		border-radius: 4px;
	}
</style>
