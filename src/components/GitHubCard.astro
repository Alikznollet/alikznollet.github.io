---
interface Props {
	url: string;
	repoName?: string;
}

const { url, repoName } = Astro.props;

// Extract repo name from URL if not provided
const displayRepo = repoName || url.split('/').slice(-2).join('/');
---

<a href={url} target="_blank" rel="noopener noreferrer" class="github-card">
	<div class="icon-side">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="gh-icon"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
	</div>
	<div class="info-side">
		<span class="label">View Source Code</span>
		<span class="repo-name">{displayRepo}</span>
	</div>
	<div class="arrow-side">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
	</div>
</a>

<style>
	.github-card {
		display: flex;
		align-items: center;
		padding: 0.75rem 1.25rem;
		background-color: #1a1a1a;
		border: 1px solid var(--card-border);
		border-radius: 12px;
		text-decoration: none;
		color: var(--text-color);
		transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
		max-width: 400px;
		flex: 1 1 200px;
	}

	.github-card:hover {
		border-color: var(--accent);
		background-color: #222;
		transform: translateY(-2px);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
		text-decoration: none;
	}

	.icon-side {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		background-color: #252525;
		border-radius: 10px;
		margin-right: 1.25rem;
		color: #ffffff;
	}

	.github-card:hover .icon-side {
		color: var(--accent);
	}

	.gh-icon {
		width: 22px;
		height: 22px;
	}

	.info-side {
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.label {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-dim);
		font-weight: 600;
		margin-bottom: 0.15rem;
	}

	.repo-name {
		font-size: 1.1rem;
		font-weight: 700;
		color: #ffffff;
	}

	.arrow-side {
		color: var(--text-dim);
		transition: transform 0.2s ease, color 0.2s ease;
	}

	.github-card:hover .arrow-side {
		transform: translate(2px, -2px);
		color: var(--accent);
	}

	.arrow-icon {
		width: 20px;
		height: 20px;
	}

	@media (max-width: 500px) {
		.github-card {
			max-width: 100%;
		}
	}
</style>
