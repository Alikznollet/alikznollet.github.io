---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import GitHubCard from '../../components/GitHubCard.astro';
import Badge from '../../components/Badge.astro';

export async function getStaticPaths() {
	const projectEntries = await getCollection('projects');
	return projectEntries.map(entry => ({
		params: { slug: entry.id }, props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} | Project Details`}>
	<a href="/" class="back-link">← Back to Home</a>
	
	<article class="project-detail">
		<header>
			{entry.data.coverImage && (
				<div class="visual-header">
					<Image src={entry.data.coverImage} alt={entry.data.title} class="hero-image" />
				</div>
			)}
			<div class="meta">
				<h1>{entry.data.title}</h1>
				<div class="tags">
					{entry.data.tags.map(tag => <Badge text={tag} />)}
				</div>
			</div>
			<p class="lead-desc">{entry.data.description}</p>
			
			{entry.data.liveUrl && (
				<div class="top-actions">
					<a href={entry.data.liveUrl} target="_blank" rel="noopener noreferrer" class="live-demo-link">
						View Live Demo →
					</a>
				</div>
			)}
		</header>

		<div class="content-body">
			<Content />
		</div>

		{(entry.data.githubUrl) && (
			<footer class="project-footer">
				<hr class="separator" />
				<div class="footer-content">
					<h3>Interested in the source?</h3>
					<GitHubCard url={entry.data.githubUrl} />
				</div>
			</footer>
		)}
	</article>
</Layout>

<style>
	.back-link {
		display: inline-block;
		margin-bottom: 2rem;
		font-size: 0.9rem;
		color: var(--text-dim);
	}

	.back-link:hover {
		color: var(--accent);
	}

	.project-detail header {
		margin-bottom: 3rem;
	}

	.visual-header {
		width: 100%;
		height: 300px;
		background-color: #000;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid var(--card-border);
		margin-bottom: 2rem;
	}

	.hero-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1rem;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.meta h1 {
		margin: 0;
		font-size: 3rem;
	}

	.tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.lead-desc {
		font-size: 1.25rem;
		color: var(--text-dim);
		margin: 0 0 1rem 0;
	}

	.top-actions {
		margin-top: 1rem;
	}

	.live-demo-link {
		display: inline-block;
		font-weight: 600;
		color: var(--accent);
		font-size: 1rem;
		text-decoration: underline;
	}

	.content-body {
		font-size: 1.1rem;
		color: var(--text-color);
		line-height: 1.7;
	}

	/* Markdown styles */
	.content-body :global(h2) {
		font-size: 1.8rem;
		margin-top: 3rem;
		border-bottom: 1px solid var(--card-border);
		padding-bottom: 0.5rem;
	}

	.content-body :global(p) {
		margin-bottom: 1.5rem;
	}

	.content-body :global(img) {
		max-width: 100%;
		border-radius: 8px;
		border: 1px solid var(--card-border);
		margin: 2rem 0;
	}

	.project-footer {
		margin-top: 4rem;
	}

	.separator {
		border: 0;
		border-top: 1px solid var(--card-border);
		margin-bottom: 3rem;
	}

	.footer-content h3 {
		margin-top: 0;
		margin-bottom: 1.5rem;
		font-size: 1.5rem;
	}

	@media (max-width: 600px) {
		.meta h1 {
			font-size: 2rem;
		}
		.visual-header {
			height: 200px;
		}
	}
</style>
