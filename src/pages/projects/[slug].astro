---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import GitHubCard from '../../components/GitHubCard.astro';
import Badge from '../../components/Badge.astro';

export async function getStaticPaths() {
	const projectEntries = await getCollection('projects');
	return projectEntries.map(entry => ({
		params: { slug: entry.id }, props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} | Project Details`}>
	<a href="/" class="back-link">← Back to Home</a>
	
	<article class="project-detail">
		<header>
			{entry.data.coverImage && (
				<div class="visual-header">
					<Image src={entry.data.coverImage} alt={entry.data.title} class="hero-image" />
				</div>
			)}
			<div class="meta">
				<h1>{entry.data.title}</h1>
				<div class="tags">
					{entry.data.tags.map(tag => <Badge text={tag} />)}
				</div>
			</div>

			<div class="actions-section">
				{entry.data.githubUrl && <GitHubCard url={entry.data.githubUrl} />}
				{entry.data.liveUrl && (
					<a href={entry.data.liveUrl} target="_blank" rel="noopener noreferrer" class="live-demo-card">
						<div class="icon-side">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="live-icon"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
						</div>
						<div class="info-side">
							<span class="label">Live Prototype</span>
							<span class="platform-name">View Demo</span>
						</div>
						<div class="arrow-side">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
						</div>
					</a>
				)}
			</div>

			<p class="lead-desc">{entry.data.description}</p>
		</header>

		<div class="content-body">
			<Content />
		</div>
	</article>
</Layout>

<style>
	.back-link {
		display: inline-block;
		margin-bottom: 2rem;
		font-size: 0.9rem;
		color: var(--text-dim);
	}

	.back-link:hover {
		color: var(--accent);
	}

	.project-detail header {
		margin-bottom: 3rem;
	}

	.visual-header {
		width: 100%;
		height: 300px;
		background-color: #000;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid var(--card-border);
		margin-bottom: 2rem;
	}

	.hero-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.5rem;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.meta h1 {
		margin: 0;
		font-size: 3rem;
	}

	.tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.actions-section {
		display: flex;
		gap: 1rem;
		margin-bottom: 2rem;
		flex-wrap: wrap;
	}

	.live-demo-card {
		display: flex;
		align-items: center;
		padding: 0.75rem 1.25rem;
		background-color: #1a1a1a;
		border: 1px solid var(--card-border);
		border-radius: 12px;
		text-decoration: none;
		color: var(--text-color);
		transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
		max-width: 300px;
		flex: 1 1 200px;
	}

	.live-demo-card:hover {
		border-color: var(--accent);
		background-color: #222;
		transform: translateY(-2px);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
		text-decoration: none;
	}

	.icon-side {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		background-color: #252525;
		border-radius: 10px;
		margin-right: 1.25rem;
		color: #ffffff;
	}

	.live-demo-card:hover .icon-side {
		color: var(--accent);
	}

	.live-icon {
		width: 20px;
		height: 20px;
	}

	.info-side {
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.label {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-dim);
		font-weight: 600;
		margin-bottom: 0.15rem;
	}

	.platform-name {
		font-size: 1.1rem;
		font-weight: 700;
		color: #ffffff;
	}

	.arrow-side {
		color: var(--text-dim);
		transition: transform 0.2s ease, color 0.2s ease;
	}

	.live-demo-card:hover .arrow-side {
		transform: translate(2px, -2px);
		color: var(--accent);
	}

	.arrow-icon {
		width: 20px;
		height: 20px;
	}

	.lead-desc {
		font-size: 1.25rem;
		color: var(--text-dim);
		margin: 0;
	}
