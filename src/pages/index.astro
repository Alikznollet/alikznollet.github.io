---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Profile from '../components/Profile.astro';
import GameCard from '../components/GameCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import profileImage from '../assets/profile.jpg';

const name = "Alex";
const description = "Game Developer and Software Engineer. I build low-level systems, interactive tools, and immersive digital experiences.";

// Fetch content from Collections
const gameEntries = await getCollection('games');
const projectEntries = await getCollection('projects');

// Sort by pubDate if available
const sortedGames = gameEntries.sort((a, b) => 
	(b.data.pubDate?.getTime() || 0) - (a.data.pubDate?.getTime() || 0)
);
const sortedProjects = projectEntries.sort((a, b) => 
	(b.data.pubDate?.getTime() || 0) - (a.data.pubDate?.getTime() || 0)
);
---

<Layout title={`${name} | Portfolio`}>
	<section>
		<Profile name={name} description={description} imageUrl={profileImage} />
	</section>

	<section id="games">
		<h2 class="section-title">Games</h2>
		{sortedGames.length > 0 ? (
			sortedGames.map(game => (
				<GameCard 
					title={game.data.title}
					description={game.data.description}
					genre={game.data.genre}
					url={`/games/${game.id}`}
				/>
			))
		) : (
			<p class="empty-msg">No games found.</p>
		)}
	</section>

	<section id="projects">
		<h2 class="section-title">Projects & Tools</h2>
		{sortedProjects.length > 0 ? (
			sortedProjects.map(project => (
				<ProjectCard 
					title={project.data.title}
					description={project.data.description}
					tags={project.data.tags}
					url={`/projects/${project.id}`}
				/>
			))
		) : (
			<p class="empty-msg">No projects found.</p>
		)}
	</section>

	<footer>
		<p>© {new Date().getFullYear()} {name} — Built with Astro</p>
	</footer>
</Layout>

<style>
	footer {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--card-border);
		color: var(--text-dim);
		font-size: 0.9rem;
		text-align: center;
	}

	.empty-msg {
		color: var(--text-dim);
		font-style: italic;
	}
</style>
